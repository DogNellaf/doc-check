# Copy to .env. Without it everything runs on the demo company, without a model.

# COMPANY_DIR=/app/knowledge/kolosok    # company.toml, rules.toml, the reference contract, specs, orders

# ============ Model ============
# none: every check is made by the rules and the search (free, nothing leaves the server)
# gigachat / openai: also reads invoice lines the rules could not find (unusual layout, bad scan)
#   The GigaChat freemium for individuals is for personal non-commercial use only,
#   a company's checker needs a paid package or a company contract (scope GIGACHAT_API_CORP/B2B)
LLM_PROVIDER=none
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# GIGACHAT_CA_BUNDLE=                # the Russian Trusted CA, certs/russian_trusted_ca.pem by default
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# ============ Limits ============
CHECKS_PER_DAY=10                    # own files per visitor (IP) a day; the examples are free
DAILY_TOKEN_BUDGET=200000            # then the model is off for the day
WORK_CONCURRENCY=1                   # checks at once, each in its own child process
CHECK_TIMEOUT=80                     # seconds, then the check is stopped
OCR_MAX_PAGES=5                      # scanned pages in one PDF
QUEUE_MAX=20
QUOTA_SALT=change-me                 # visitor ids are kept as salted hashes
UPLOAD_MAX_BYTES=5000000
RESULT_TTL=3600                      # how long a report stays downloadable

ALLOWED_ORIGINS=*
